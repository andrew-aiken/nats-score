{
  "checks": {
    "noop": {
      "frequency": 15,
      "type": "noop",
      "description": "No operation check",
      "scoreWeight": 1
    },
    "ssh": {
      "frequency": 30,
      "name": "SSH Check",
      "type": "ssh",
      "description": "ICMP check",
      "scoreWeight": 1,
      "definition": {
        "command": "whoami",
        "ContentRegex": "pi",
        "MatchContent": true,
        "host": "192.168.0.31",
        "port": 22,
        "username": "pi",
        "password": "raspberry123"
      },
      "mutableFields": ["password"]
    },
    "icmp": {
      "frequency": 30,
      "name": "Fancy ICMP",
      "type": "icmp",
      "description": "ICMP check",
      "scoreWeight": 1,
      "definition": {
        "host": "1.1.{{.TeamNumber}}.1"
      },
      "mutableFields": ["host"]
    },
    "http": {
      "frequency": 90,
      "type": "http",
      "description": "HTTP Check",
      "scoreWeight": 2,
      "definition": {
        "host": "ifconfig.me",
        "path": "/ip",
        "MatchCode": true,
        "MatchContent": true,
        "ContentRegex": "97.89.244.253",
        "VerifyCert": true
      }
    },
    "dns": {
      "type": "dns",
      "description": "DNS Check",
      "scoreWeight": 1,
      "definition": {
        "server": "1.1.1.1",
        "fqdn": "machinemetrics.ai",
        "expected_result": "v=spf1 include:spf.efwd.registrar-servers.com ~all",
        "record_type": "TXT"
      }
    }
  }
}
